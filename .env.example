HOST=127.0.0.1
PORT=4310
# DB_PATH=/absolute/path/support.db
# COOKIE_SECURE=1
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=configure-outside-source-control
# 网站采集、MCP、OpenAPI 调用允许访问的 origin（精确匹配，逗号分隔）
# INTEGRATION_ALLOWED_ORIGINS=https://tools.example,https://api.example,https://help.example
# FC_SECRET_SERVICE_TOKEN=configure-outside-source-control

# Optional: stable 32-byte Base64 encryption key for model provider credentials.
# If omitted, the server creates <DB_PATH>.key with mode 0600 on first key save.
# Keep the same master key when restoring backups; never commit real keys.
# FC_MASTER_KEY=configure-outside-source-control
# FC_SECRET_PROVIDER_A=configure-outside-source-control

# Optional Telegram reply polling when no public HTTPS webhook is configured.
# Disable the bot webhook without dropping pending updates before enabling.
# TELEGRAM_POLLING=1

# Optional iOS staff app APNs. Mount .p8 read-only; never commit real keys.
# APNS_KEY_FILE=/app/secrets/AuthKey.p8
# APNS_KEY_ID=your-key-id
# APNS_TEAM_ID=your-team-id
# APNS_TOPIC=your.staff.app.bundle.id

# User Flutter app push; separate credentials/topic from the staff app.
# USER_APNS_KEY_FILE=/app/secrets/UserAuthKey.p8
# USER_APNS_KEY_ID=your-user-key-id
# USER_APNS_TEAM_ID=your-team-id
# USER_APNS_TOPIC=your.user.app.bundle.id
# USER_FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-user-service-account.json
